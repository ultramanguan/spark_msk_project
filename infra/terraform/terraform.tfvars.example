aws_region = "us-east-1"
project_name = "retail-lakehouse"
environment = "dev"

# Fill these in for your account -- see README.md in this directory.
# 2 is the minimum MSK Serverless requires (different AZs) -- adding a 3rd buys nothing here.
vpc_id     = "vpc-084e8fc1bb45473da"
subnet_ids = ["subnet-000346bb66cfe1042", "subnet-078bb93daeae524ad"]

# enable_mwaa defaults to false (see variables.tf) -- the study/interactive path (EMR learning cluster +
# JupyterHub) doesn't need MWAA at all. Uncomment the two lines below only if you set enable_mwaa = true
# for the full scheduled-production-pipeline path (see RUNBOOK_AWS.md).
# enable_mwaa = true
#
# An existing PUBLIC subnet, distinct from subnet_ids above, used only to host the NAT Gateway that
# networking.tf creates to make subnet_ids private when enable_mwaa = true (MWAA rejects public subnets
# outright; MSK/EMR don't need this at all).
# nat_gateway_subnet_id = "subnet-05a05fb168dcc399f"
